# Browser settings
BROWSER=chromium
HEADLESS=false
SLOW_MO=0
TIMEOUT=30000
BASE_URL=https://www.google.com

# Retry settings
MAX_RETRIES=3
RETRY_DELAY=1.0

# Database settings (SQLite by default)
DB_URL=sqlite:///data/test.db

# PostgreSQL example:
# DB_URL=postgresql+psycopg2://user:password@localhost:5432/test_db

# MySQL example:
# DB_URL=mysql+pymysql://user:password@localhost:3306/test_db
